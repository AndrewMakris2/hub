# Copy to .env (gitignored — real values never get committed) if you want a
# local reference or plan to use `netlify env:import .env`. Either way, these
# still have to actually be set in Netlify's dashboard (Site settings →
# Environment variables) for the deployed functions to read them — a local
# .env file only matters for `netlify dev`.
#
# Everything else in this project is credential-free. These five only exist
# for the scheduled YouTube auto-poster — see README.md "Environment
# variables" for the full setup checklist (creating the OAuth client,
# publishing the consent screen, getting the refresh token).

# Second OAuth Client ID (type "Web application") in the same Google Cloud
# project the browser-side googleClientId setting already uses. Needs a
# client secret, which the browser-side client can't have.
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_SERVER_CLIENT_SECRET=

# Obtained by visiting /.netlify/functions/youtube-auth-start once the two
# vars above are set and deployed — the callback page shows it once to copy
# in here (or straight into Netlify's dashboard).
YOUTUBE_REFRESH_TOKEN=

# The fixed title used for every auto-post. Defaults to "Vantage auto-post"
# if left unset.
AUTOPOST_TITLE=

# Any random string you pick — gates the scheduled function's internal
# handoff to the background function that does the actual upload.
INTERNAL_TRIGGER_SECRET=
